---
import '../styles/global.css';
import '../styles/fonts.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Betell</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script>
      (function () {
        const savedTheme = localStorage.getItem('theme');
        const systemPrefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        const initialTheme = savedTheme || (systemPrefersLight ? 'light' : 'dark');

        const html = document.documentElement;
        if (initialTheme === 'light') {
          html.classList.add('light');
          html.classList.remove('dark');
        } else {
          html.classList.add('dark');
          html.classList.remove('light');
        }
      })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
  </head>

  <body class="overflow-x-hidden">
    <Nav />
    <Contact />
    <!-- Solo mostrar overlay en desktop -->
    <div id="nav-overlay" class="hidden lg:block"></div>

    <!-- Contenido principal -->
    <div id="page-content" class="w-full lg:transition-all lg:duration-300">
      <main id="main-content" class="min-h-screen bg-page">
        <div class="h-full">
          <slot />
        </div>
      </main>
      <Footer />
    </div>

    <script>
      import { gsap, ScrollTrigger } from '../lib/gsap';

      // Variables globales para el estado del nav
      let isOpen = true;
      let navInstance: HTMLElement | null = null;
      let resizeTimeout: NodeJS.Timeout | undefined;

      // Función CRÍTICA: Calcular y aplicar el ancho inicial
      const applyInitialNavWidth = () => {
        navInstance = document.getElementById('nav-lateral');

        if (!navInstance || window.innerWidth < 1024) return;

        // 1. REMOVER temporalmente la transform para medir el ancho REAL
        const originalTransform = navInstance.style.transform;
        navInstance.style.transform = 'none';
        navInstance.style.opacity = '0'; // Ocultar momentáneamente

        // 2. Forzar reflow para que el navegador calcule el ancho sin transform
        void navInstance.offsetWidth;

        // 3. Obtener el ancho REAL del nav (sin transformaciones CSS)
        const navWidth = navInstance.scrollWidth;
        console.log('Ancho REAL del nav:', navWidth);

        // 4. Aplicar el ancho como variable CSS
        document.documentElement.style.setProperty('--nav-offset', `${navWidth}px`);

        // 5. Restaurar la transform y mostrar
        navInstance.style.transform = originalTransform;
        setTimeout(() => {
          navInstance!.style.opacity = '1';
        }, 10);

        // 6. Aplicar clase de estado abierto
        document.body.classList.add('nav-open');
        isOpen = true;

        return navWidth;
      };

      const setNavOffset = (value: number) => {
        document.documentElement.style.setProperty('--nav-offset', `${value}px`);
      };

      const setupNavToggle = () => {
        if (!navInstance || window.innerWidth < 1024) return;

        navInstance.addEventListener('click', (e) => {
          const target = e.target as Element;
          const toggleElement = target.closest('[data-nav-toggle]');

          if (toggleElement) {
            e.preventDefault();
            toggleNav();
          }
        });
      };

      const toggleNav = () => {
        if (!navInstance || window.innerWidth < 1024) return;

        if (isOpen) {
          // CERRAR nav - mostrar solo la pestaña (10px)
          setNavOffset(10);
          document.body.classList.remove('nav-open');
          isOpen = false;
          console.log('Nav cerrado');
        } else {
          // ABRIR nav - mostrar completo
          const navWidth = navInstance.scrollWidth;
          setNavOffset(navWidth);
          document.body.classList.add('nav-open');
          isOpen = true;
          console.log('Nav abierto - Ancho:', navWidth);
        }

        // Refrescar ScrollTrigger después de la animación
        setTimeout(() => {
          if (typeof ScrollTrigger !== 'undefined') {
            ScrollTrigger.refresh();
          }
        }, 350);
      };

      // INICIALIZACIÓN PRINCIPAL - SECUENCIA CORRECTA
      const initDesktopNav = () => {
        // Solo en desktop
        if (window.innerWidth < 1024) {
          // Reset para mobile
          document.body.classList.remove('nav-open');
          document.documentElement.style.removeProperty('--nav-offset');
          return;
        }

        console.log('🔄 Inicializando nav desktop...');

        // 1. Aplicar ancho inicial (CRÍTICO)
        const initialWidth = applyInitialNavWidth();

        // 2. Configurar toggle
        setupNavToggle();

        console.log('✅ Nav inicializado. Ancho:', initialWidth);
      };

      // Inicializar ScrollTrigger
      const initScrollTriggers = () => {
        if (typeof ScrollTrigger !== 'undefined') {
          ScrollTrigger.matchMedia({
            '(min-width: 1024px)': function () {
              console.log('📱 ScrollTrigger activo para desktop');

              // Pequeño delay para asegurar que el DOM está listo
              setTimeout(() => {
                initDesktopNav();
              }, 50);

              return () => {
                console.log('🧹 Limpiando ScrollTrigger desktop');
              };
            },

            '(max-width: 1023px)': function () {
              console.log('📱 Modo mobile/tablet activo');

              // Resetear para mobile
              isOpen = false;
              document.body.classList.remove('nav-open');
              document.documentElement.style.removeProperty('--nav-offset');

              if (navInstance) {
                navInstance.style.transform = '';
                navInstance.style.opacity = '1';
              }

              return () => {
                console.log('🧹 Limpiando ScrollTrigger mobile');
              };
            },
          });

          // Refrescar ScrollTrigger después de que todo esté listo
          setTimeout(() => {
            ScrollTrigger.refresh();
            console.log('🔄 ScrollTrigger refrescado');
          }, 300);
        }
      };

      // PUNTO DE ENTRADA PRINCIPAL - Orden correcto
      const initApp = () => {
        // 1. Inicializar nav inmediatamente (para primera carga)
        initDesktopNav();

        // 2. Inicializar ScrollTrigger
        initScrollTriggers();

        // 3. Forzar un refresh después de que todo cargue
        window.addEventListener('load', () => {
          setTimeout(() => {
            initDesktopNav(); // Re-aplicar por si hay imágenes/fuentes que cambian el layout
            if (typeof ScrollTrigger !== 'undefined') {
              ScrollTrigger.refresh();
            }
          }, 500);
        });
      };

      // Ejecutar cuando el DOM esté listo
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }

      // Manejar resize
      window.addEventListener('resize', () => {
        if (resizeTimeout) {
          clearTimeout(resizeTimeout);
        }

        resizeTimeout = setTimeout(() => {
          initDesktopNav();

          if (typeof ScrollTrigger !== 'undefined') {
            ScrollTrigger.refresh();
          }

          resizeTimeout = undefined;
        }, 250);
      });
    </script>
  </body>
</html>
