---
import '../styles/global.css';
import '../styles/fonts.css';
import Nav from '../components/Nav.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Betell</title>
  </head>

  <body class="overflow-x-hidden">
    <Nav />
    <div id="nav-overlay"></div>

    <main id="main-content" class="min-h-screen bg-page transition-[margin,width] duration-300">
      <div class="h-full px-24">
        <slot />
      </div>
    </main>

    <script>
      import { gsap, ScrollTrigger } from '../lib/gsap';
      const nav = document.getElementById('nav-lateral');
      const overlay = document.getElementById('nav-overlay');

      const TAB_WIDTH = 10;
      let isOpen = false;

      const setNavOffset = (value: number) => {
        document.documentElement.style.setProperty('--nav-offset', `${value}px`);
      };

      setNavOffset(TAB_WIDTH);

      const openNav = () => {
        if (!nav) return;
        const navWidth = nav.getBoundingClientRect().width;
        isOpen = true;
        setNavOffset(navWidth);
        document.body.classList.add('nav-open');
        ScrollTrigger.refresh(true);
      };

      const closeNav = () => {
        isOpen = false;
        setNavOffset(TAB_WIDTH);
        document.body.classList.remove('nav-open');
        ScrollTrigger.refresh(true);
      };

      nav?.addEventListener('click', (e) => {
        const target = e.target;
        if (!target) return;
        const el = target instanceof Element ? target : null;
        if (el && (el.closest('a') || el.closest('button') || el.closest('h3') || el.closest('h4')))
          return;

        isOpen ? closeNav() : openNav();
      });

      overlay?.addEventListener('click', closeNav);

      window.addEventListener('resize', () => {
        if (!nav) return;
        const navWidth = nav.getBoundingClientRect().width;
        if (isOpen) {
          setNavOffset(navWidth);
          document.body.classList.add('nav-open');
        } else {
          setNavOffset(TAB_WIDTH);
          document.body.classList.remove('nav-open');
        }
        ScrollTrigger.refresh(true);
      });
    </script>
  </body>
</html>
