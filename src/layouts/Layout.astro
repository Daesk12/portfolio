---
import '../styles/global.css';
import '../styles/fonts.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Betell</title>

    <script>
      (function () {
        const savedTheme = localStorage.getItem('theme');
        const systemPrefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        const initialTheme = savedTheme || (systemPrefersLight ? 'light' : 'dark');

        const html = document.documentElement;
        if (initialTheme === 'light') {
          html.classList.add('light');
          html.classList.remove('dark');
        } else {
          html.classList.add('dark');
          html.classList.remove('light');
        }
      })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
  </head>

  <body class="overflow-x-hidden">
    <Nav />
    <Contact />
    <!-- Solo mostrar overlay en desktop -->
    <div id="nav-overlay" class="hidden lg:block"></div>

    <!-- Contenido principal -->
    <div
      id="page-content"
      class="/* Desktop: con margen para el nav lateral */
      lg:ml-[calc(25%-10px)] lg:w-[calc(100%-25%+10px)]
      
      /* Tablet y móvil: sin margen */
      w-full
      
      /* Transición suave solo en desktop */
      lg:transition-all lg:duration-300">
      <main id="main-content" class="min-h-screen bg-page">
        <div class="h-full">
          <slot />
        </div>
      </main>
      <Footer />
    </div>

    <script>
      import { gsap, ScrollTrigger } from '../lib/gsap';
      const nav = document.getElementById('nav-lateral');
      const overlay = document.getElementById('nav-overlay');

      const TAB_WIDTH = 10;
      let isOpen = true;
      let scrollTriggersInitialized = false;

      // Solo funciona en desktop (≥ 1024px)
      const isDesktop = () => window.innerWidth >= 1024;

      const setNavOffset = (value: number) => {
        if (!isDesktop()) return; // Solo en desktop
        document.documentElement.style.setProperty('--nav-offset', `${value}px`);
      };

      const initDesktopNav = () => {
        // SOLO ejecutar en desktop (≥1024px)
        if (window.innerWidth >= 1024 && nav) {
          const navWidth = nav.getBoundingClientRect().width;
          setNavOffset(navWidth);
          document.body.classList.add('nav-open');
          isOpen = true;

          if (!scrollTriggersInitialized && ScrollTrigger) {
            ScrollTrigger.addEventListener('refreshInit', () => {
              console.log('ScrollTrigger inicializado correctamente');
            });
            scrollTriggersInitialized = true;
          }
        } else {
          // En móvil/tablet, asegurar que NO haya clases de desktop
          document.body.classList.remove('nav-open');
          document.documentElement.style.removeProperty('--nav-offset');

          // Asegurar que el nav sea visible y en posición correcta
          if (nav) {
            // Remover cualquier estilo de transform que haya puesto el JS de desktop
            nav.style.transform = '';
            nav.style.position = '';
            nav.style.top = '';
            nav.style.left = '';
            nav.style.right = '';
            nav.style.width = '';
            nav.style.height = '';
          }
        }
      };

      if (nav) {
        setTimeout(() => {
          initDesktopNav();
        }, 100);
      } else {
        if (isDesktop()) {
          setNavOffset(TAB_WIDTH);
        }
      }

      const openNav = () => {
        if (!isDesktop() || !nav) return;

        const navWidth = nav.getBoundingClientRect().width;
        isOpen = true;
        setNavOffset(navWidth);
        document.body.classList.add('nav-open');

        debouncedScrollTriggerRefresh();
      };

      const closeNav = () => {
        if (!isDesktop()) return;

        isOpen = false;
        setNavOffset(TAB_WIDTH);
        document.body.classList.remove('nav-open');

        debouncedScrollTriggerRefresh();
      };

      let refreshTimeout: ReturnType<typeof setTimeout> | null = null;
      const debouncedScrollTriggerRefresh = () => {
        if (refreshTimeout !== null) {
          clearTimeout(refreshTimeout);
        }
        refreshTimeout = setTimeout(() => {
          if (ScrollTrigger && isDesktop()) {
            ScrollTrigger.refresh();
          }
          refreshTimeout = null;
        }, 350);
      };

      // Solo añadir el toggle click en desktop
      if (isDesktop()) {
        nav?.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;

          if (!target.closest('[data-nav-toggle]')) return;

          isOpen ? closeNav() : openNav();
        });
      }

      let resizeTimeout: ReturnType<typeof setTimeout> | null = null;
      window.addEventListener('resize', () => {
        if (!nav) return;

        if (resizeTimeout !== null) {
          clearTimeout(resizeTimeout);
        }

        // Re-inicializar según el tamaño de pantalla
        initDesktopNav();

        resizeTimeout = setTimeout(() => {
          if (ScrollTrigger && window.innerWidth >= 1024) {
            ScrollTrigger.refresh();
          }
          resizeTimeout = null;
        }, 250);
      });

      window.addEventListener('load', () => {
        setTimeout(() => {
          if (ScrollTrigger && isDesktop()) {
            ScrollTrigger.refresh();
          }
        }, 500);
      });
    </script>
  </body>
</html>
