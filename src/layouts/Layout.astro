---
import '../styles/global.css';
import '../styles/fonts.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Betell</title>
  </head>

  <body class="overflow-x-hidden">
    <Nav />
    <div id="nav-overlay"></div>
    <div id="page-content">
      <main id="main-content" class="min-h-screen bg-page transition-[margin,width] duration-300">
        <div class="h-full">
          <slot />
        </div>
      </main>
      <Footer />
    </div>

    <script>
      import { gsap, ScrollTrigger } from '../lib/gsap';
      const nav = document.getElementById('nav-lateral');
      const overlay = document.getElementById('nav-overlay');

      const TAB_WIDTH = 10;
      let isOpen = false;

      const setNavOffset = (value: number) => {
        document.documentElement.style.setProperty('--nav-offset', `${value}px`);
      };

      setNavOffset(TAB_WIDTH);

      const openNav = () => {
        if (!nav) return;
        const navWidth = nav.getBoundingClientRect().width;
        isOpen = true;
        setNavOffset(navWidth);
        document.body.classList.add('nav-open');
        setTimeout(() => ScrollTrigger.refresh(true), 100);
      };

      const closeNav = () => {
        isOpen = false;
        setNavOffset(TAB_WIDTH);
        document.body.classList.remove('nav-open');
        setTimeout(() => ScrollTrigger.refresh(true), 100);
      };

      nav?.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;

        if (!target.closest('[data-nav-toggle]')) return;

        isOpen ? closeNav() : openNav();
      });

      window.addEventListener('resize', () => {
        if (!nav) return;
        const navWidth = nav.getBoundingClientRect().width;
        if (isOpen) {
          setNavOffset(navWidth);
          document.body.classList.add('nav-open');
          setTimeout(() => ScrollTrigger.refresh(true), 100);
        } else {
          setNavOffset(TAB_WIDTH);
          document.body.classList.remove('nav-open');
          setTimeout(() => ScrollTrigger.refresh(true), 100);
        }
      });
    </script>
  </body>
</html>
