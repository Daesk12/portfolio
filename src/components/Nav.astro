---
import { projects } from '../data/projects';
import type { Project } from '../data/projects';
---

<nav
  id="nav-lateral"
  class="fixed left-0 top-0 h-full w-1/4 bg-secondary p-4 transition-transform duration-300 z-50">
  <div class="absolute inset-0 z-0 pointer-events-auto" data-nav-toggle aria-hidden="true"></div>
  <div class="relative z-10 flex justify-between h-full flex-col pointer-events-auto">
    <ul class="flex justify-start flex-col gap-1">
      <li>
        <a
          href="/"
          class="hover:text-accent text-muted font-extrabold tracking-wide text-h3 font-outfit">
          BETELL
        </a>
      </li>
      <li>
        <a
          href="/trabajos/home"
          class="hover:text-accent text-muted font-extrabold tracking-wide font-outfit text-h3">
          TRABAJOS
        </a>
      </li>
      <li>
        <a
          href="/sobre-mi"
          class="hover:text-accent text-muted font-extrabold tracking-wide font-outfit text-h3">
          SOBRE MI
        </a>
      </li>
      <button
        id="contact-button"
        data-contact-open
        class="bg-page p-2.5 w-full text-primary text-button rounded-lg hover:bg-accent hover:text-muted font-medium tracking-lg font-outfit cursor-pointer">
        Contacto
      </button>
    </ul>

    <div class="flex justify-start gap-2 flex-col">
      <h3
        class="text-h3 font-700 font-outfit tracking-wider text-muted underline underline-offset-4">
        PREVIEW
      </h3>
      <div class="flex flex-col gap-5 max-h-[44vh] overflow-y-auto pr-3 preview-scroll">
        {
          projects.slice(0, 4).map((project) => (
            <div class="flex flex-col gap-2 justify-start">
              <h3 class="text-h4 font-inconsolata font-600 tracking-wide text-muted">
                {project.title}
              </h3>
              <p class="text-caption font-manrope tracking-wider font-100 text-muted">
                {project.year}
              </p>
              <p class="text-author font-manrope tracking-wider font-100 leading-base text-muted">
                {project.author.replace(/\n/g, ' - ')}
              </p>
              <p class="text-preview-p font-manrope font-500 text-muted">
                {project.preview?.es || 'Descripción no definida'}
              </p>
              <a href={`/trabajos/${project.slug}`}>
                <button class="cursor-pointer min-w-20 bg-page p-2 w-1/3 text-primary rounded-lg hover:bg-accent hover:text-muted font-medium tracking-lg font-outfit">
                  Ver más
                </button>
              </a>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex justify-between items-center">
      <!--
      <p class="text-language font-900 text-muted">
        <span>ES</span>/<span>EN</span>
      </p>
      -->
      <div id="theme" class="w-8 h-8 text-muted hover:text-accent">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-8 text-muted hover:text-accent">
          <path
            d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.758 17.303a.75.75 0 0 0-1.061-1.06l-1.591 1.59a.75.75 0 0 0 1.06 1.061l1.591-1.59ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.697 7.757a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 0 0-1.061 1.06l1.59 1.591Z"
          ></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-8 hidden text-muted hover:text-accent">
          <path
            fill-rule="evenodd"
            d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z"
            clip-rule="evenodd"></path>
        </svg>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const themeBtn = document.getElementById('theme');

    const updateIcons = () => {
      const icons = themeBtn?.querySelectorAll('svg');
      if (!icons || icons.length < 2) return;

      const isLight = document.documentElement.classList.contains('light');

      if (isLight) {
        icons[0].classList.add('hidden');
        icons[1].classList.remove('hidden');
      } else {
        icons[0].classList.remove('hidden');
        icons[1].classList.add('hidden');
      }

      console.log('🎨 Icono muestra:', isLight ? 'LUNA 🌙 (clic → DARK)' : 'SOL ☀️ (clic → LIGHT)');
    };

    updateIcons();

    themeBtn?.addEventListener('click', () => {
      const html = document.documentElement;
      const isLight = html.classList.contains('light');
      const newTheme = isLight ? 'dark' : 'light';

      if (newTheme === 'light') {
        html.classList.add('light');
        html.classList.remove('dark');
      } else {
        html.classList.add('dark');
        html.classList.remove('light');
      }

      localStorage.setItem('theme', newTheme);

      updateIcons();

      console.log(
        '🔄 Cambiado a:',
        newTheme.toUpperCase(),
        '| Icono ahora muestra:',
        newTheme === 'light' ? 'LUNA 🌙' : 'SOL ☀️'
      );
    });

    if (themeBtn) {
      themeBtn.style.cursor = 'pointer';
      themeBtn.title =
        'Cambiar a tema ' +
        (document.documentElement.classList.contains('light') ? 'oscuro' : 'claro');
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    if (target.closest('[data-contact-open]')) {
      window.dispatchEvent(new CustomEvent('open-contact'));
    }
  });
</script>
