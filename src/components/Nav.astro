---
import { projects } from '../data/projects';
import type { Project } from '../data/projects';
---

<button
  id="mobile-menu-toggle"
  class="fixed top-4 right-4 w-10 h-10 flex flex-col justify-center items-center gap-1.5 bg-secondary rounded-lg p-2 border-2 border-transparent hover:border-accent transition-all duration-200 z-9998 lg:hidden md:hidden max-md:flex"
  aria-label="Abrir menú">
  <span class="w-6 h-0.5 bg-muted rounded-full transition-all"></span>
  <span class="w-6 h-0.5 bg-muted rounded-full transition-all"></span>
  <span class="w-6 h-0.5 bg-muted rounded-full transition-all"></span>
</button>

<nav
  id="nav-lateral"
  class="fixed left-0 top-0 h-full 2xl:w-1/6 w-1/4 bg-secondary p-4 transition-transform duration-300 z-50
    max-lg:fixed max-lg:top-0 max-lg:left-0 max-lg:right-0 max-lg:w-full max-lg:p-4
    max-lg:flex max-lg:flex-row max-lg:items-center max-lg:justify-between max-lg:h-auto
    max-md:fixed max-md:top-0 max-md:left-0 max-md:right-0 max-md:w-full
    max-md:flex-col max-md:items-center max-md:justify-center max-md:min-h-screen max-md:z-30
    max-md:transform max-md:-translate-y-full max-md:transition-transform max-md:duration-500 max-md:ease-out">
  <div
    class="absolute inset-0 z-0 pointer-events-auto max-lg:hidden"
    data-nav-toggle
    aria-hidden="true">
  </div>

  <div
    class="relative z-10 flex justify-between h-full flex-col pointer-events-auto
      max-lg:flex-row max-lg:items-center max-lg:w-full max-lg:h-auto
      max-md:flex-col max-md:items-center max-md:justify-center
      max-md:min-h-screen max-md:w-full max-md:px-6 max-md:py-20 max-md:gap-8">
    <ul
      class="flex justify-between flex-col gap-1
        max-lg:flex-row max-lg:items-center max-lg:gap-6
        max-md:flex-col max-md:items-center max-md:gap-2 max-md:w-full">
      <li>
        <a
          href="/"
          class="hover:text-accent text-muted font-extrabold tracking-wide text-h3 font-outfit max-md:text-2xl">
          BETELL
        </a>
      </li>
      <li>
        <a
          href="/trabajos/home"
          class="hover:text-accent text-muted font-extrabold tracking-wide font-outfit text-h3 max-md:text-2xl">
          TRABAJOS
        </a>
      </li>
      <li>
        <a
          href="/sobre-mi"
          class="hover:text-accent text-muted font-extrabold tracking-wide font-outfit text-h3 max-md:text-2xl">
          SOBRE MI
        </a>
      </li>

      <li class="max-lg:block max-md:w-full max-md:text-center max-md:mt-4">
        <button
          id="contact-button-mobile"
          data-contact-open
          class="bg-page p-2.5 pl-4 pr-4 text-primary text-button rounded-lg hover:bg-accent hover:text-muted font-medium tracking-lg font-outfit cursor-pointer transition-colors max-lg:px-6 max-md:w-auto max-md:max-w-xs max-md:text-lg max-md:py-3">
          Contacto
        </button>
      </li>
    </ul>

    <div class="flex justify-start gap-2 flex-col max-lg:hidden">
      <h3
        class="text-h3 font-700 font-outfit tracking-wider text-muted underline underline-offset-4">
        PREVIEW
      </h3>
      <div class="flex flex-col gap-5 max-h-[44vh] overflow-y-auto pr-3 preview-scroll">
        {
          projects.slice(0, 4).map((project) => (
            <div class="flex flex-col gap-2 justify-start">
              <h3 class="text-h4 font-inconsolata font-600 tracking-wide text-muted">
                {project.title}
              </h3>
              <p class="text-caption font-manrope tracking-wider font-100 text-muted">
                {project.year}
              </p>
              <p class="text-author font-manrope tracking-wider font-100 leading-base text-muted">
                {project.author.replace(/\n/g, ' - ')}
              </p>
              <p class="text-preview-p font-manrope font-500 text-muted">
                {project.preview?.es || 'Descripción no definida'}
              </p>
              <a href={`/trabajos/${project.slug}`}>
                <button class="cursor-pointer min-w-20 bg-page pl-4 pr-4 p-2 w-auto text-primary text-caption rounded-lg hover:bg-accent hover:text-muted font-medium tracking-lg font-outfit">
                  Ver más
                </button>
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <div class="flex justify-between items-center max-lg:flex-row max-lg:gap-4 max-md:flex-col">
      <div
        id="theme"
        class="w-8 h-8 text-muted hover:text-accent cursor-pointer max-lg:ml-auto max-md:mx-auto">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-8 text-muted hover:text-accent transition-colors">
          <path
            d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.758 17.303a.75.75 0 0 0-1.061-1.06l-1.591 1.59a.75.75 0 0 0 1.06 1.061l1.591-1.59ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.697 7.757a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 0 0-1.061 1.06l1.59 1.591Z"
          ></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-8 hidden text-muted hover:text-accent">
          <path
            fill-rule="evenodd"
            d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z"
            clip-rule="evenodd"></path>
        </svg>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const nav = document.getElementById('nav-lateral');

    function toggleMobileMenu() {
      if (!nav || !toggleBtn) return;

      const isMenuOpen = !nav.classList.contains('max-md:-translate-y-full');

      if (isMenuOpen) {
        nav.classList.add('max-md:-translate-y-full');
        nav.classList.remove('max-md:translate-y-0');
        document.body.style.overflow = '';
        toggleBtn.setAttribute('aria-label', 'Abrir menú');
      } else {
        nav.classList.remove('max-md:-translate-y-full');
        nav.classList.add('max-md:translate-y-0');
        document.body.style.overflow = 'hidden';
        toggleBtn.setAttribute('aria-label', 'Cerrar menú');
      }
    }

    function closeMobileMenu() {
      if (!nav || !toggleBtn) return;

      nav.classList.add('max-md:-translate-y-full');
      nav.classList.remove('max-md:translate-y-0');
      document.body.style.overflow = '';
      toggleBtn.setAttribute('aria-label', 'Abrir menú');
    }

    function openContactModal() {
      closeMobileMenu();
      window.dispatchEvent(
        new CustomEvent('open-contact', {
          detail: { source: 'nav-mobile' },
        })
      );
    }

    function initTheme() {
      const themeBtn = document.getElementById('theme');

      const updateIcons = () => {
        const icons = themeBtn?.querySelectorAll('svg');
        if (!icons || icons.length < 2) return;

        const isLight = document.documentElement.classList.contains('light');

        if (isLight) {
          icons[0].classList.add('hidden');
          icons[1].classList.remove('hidden');
        } else {
          icons[0].classList.remove('hidden');
          icons[1].classList.add('hidden');
        }
      };

      updateIcons();

      themeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const html = document.documentElement;
        const isLight = html.classList.contains('light');
        const newTheme = isLight ? 'dark' : 'light';

        if (newTheme === 'light') {
          html.classList.add('light');
          html.classList.remove('dark');
        } else {
          html.classList.add('dark');
          html.classList.remove('light');
        }

        localStorage.setItem('theme', newTheme);
        updateIcons();
      });

      if (themeBtn) {
        themeBtn.style.cursor = 'pointer';
        themeBtn.title = 'Cambiar tema';
      }
    }

    initTheme();

    const contactButton = document.getElementById('contact-button-mobile');
    if (contactButton) {
      contactButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openContactModal();
      });
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const contactBtn = target.closest('[data-contact-open]');
      if (contactBtn) {
        e.preventDefault();
        e.stopImmediatePropagation();
        openContactModal();
      }
    });

    if (window.innerWidth < 1024) {
      if (toggleBtn) {
        toggleBtn.addEventListener('click', toggleMobileMenu);
      }

      const navLinks = document.querySelectorAll('#nav-lateral a[href]:not([data-contact-open])');
      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          closeMobileMenu();
        });
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) {
          closeMobileMenu();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMobileMenu();
      }
    });
  });
</script>
