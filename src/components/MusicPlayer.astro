---
import { canciones } from '../data/music';

const initialIndex = 0;
const currentSong = canciones[initialIndex];
---

<section class="flex flex-col p-20 gap-20
max-lg:px-12 max-md:px-8 max-lg:pb-10 max-lg:gap-10">
  <div class="flex flex-col gap-1">
    <h1 class="text-herotitle font-900 tracking-wider font-outfit text-primary text-center">
      SOBRE MI
    </h1>
    <h2 class="text-caption font-700 tracking-wider font-manrope text-primary text-center">
      ANTES DE SER DISEÑADOR SOY UN SER HUMANO
    </h2>
  </div>
  <div class="flex justify-center gap-5 items-center
  max-lg:flex-col max-lg:gap-10">
    <div class="flex flex-col gap-5 items-center justify-center w-2/5">
      <div class="w-80 h-80 bg-primary rounded-lg overflow-hidden relative">
        <img
          id="cover"
          src={currentSong.image}
          alt={currentSong.title}
          class="w-full aspect-square object-cover"
        />
      </div>
      <div class="flex items-center gap-10">
        <button id="prev" class="text-primary cursor-pointer hover:text-accent">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-6 w-6">
            <path
              d="M9.195 18.44c1.25.714 2.805-.189 2.805-1.629v-2.34l6.945 3.968c1.25.715 2.805-.188 2.805-1.628V8.69c0-1.44-1.555-2.343-2.805-1.628L12 11.029v-2.34c0-1.44-1.555-2.343-2.805-1.628l-7.108 4.061c-1.26.72-1.26 2.536 0 3.256l7.108 4.061Z"
            ></path>
          </svg>
        </button>
        <button
          id="play"
          aria-label="Reproducir / Pausar"
          class="p-3 bg-secondary rounded-full text-muted hover:bg-accent hover:text-primary transition-all cursor-pointer">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-8 w-8"
            id="icon-play">
            <path
              fill-rule="evenodd"
              d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z"
              clip-rule="evenodd"></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-8 w-8 hidden"
            id="icon-pause">
            <path
              fill-rule="evenodd"
              d="M6.75 5.25a.75.75 0 0 1 .75-.75H9a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H7.5a.75.75 0 0 1-.75-.75V5.25Zm7.5 0A.75.75 0 0 1 15 4.5h1.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H15a.75.75 0 0 1-.75-.75V5.25Z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
        <button id="next" class="text-primary cursor-pointer hover:text-accent">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-6 w-6">
            <path
              d="M5.055 7.06C3.805 6.347 2.25 7.25 2.25 8.69v8.122c0 1.44 1.555 2.343 2.805 1.628L12 14.471v2.34c0 1.44 1.555 2.343 2.805 1.628l7.108-4.061c1.26-.72 1.26-2.536 0-3.256l-7.108-4.061C13.555 6.346 12 7.249 12 8.689v2.34L5.055 7.061Z"
            ></path>
          </svg>
        </button>
      </div>
    </div>
    <div class="w-2/5
    max-lg:w-full">
      <div id="waveform" class="w-full h-32"></div>
    </div>
  </div>
</section>

<script>
  import WaveSurfer from 'wavesurfer.js';
  import { canciones } from '../data/music';

  // ===== VARIABLES GLOBALES CON TIPOS =====
  let currentIndex: number = 0;
  let wavesurfer: any = null;

  // ===== FUNCIONES =====
  function getCurrentSong() {
    return canciones[currentIndex];
  }

  function updateWaveColors() {
    if (!wavesurfer) return;

    const song = getCurrentSong();
    const isLight = document.documentElement.classList.contains('light');

    const waveColor = isLight ? song.waveColorLight || song.waveColor : song.waveColor;

    const progressColor = isLight
      ? song.progressColorLight || song.progressColor
      : song.progressColor;

    // Actualizar colores
    wavesurfer.setOptions({
      waveColor,
      progressColor,
    });

    // Redibujar (WaveSurfer 7+)
    if (wavesurfer.drawer?.redraw) {
      wavesurfer.drawer.redraw();
    } else if (wavesurfer.drawBuffer) {
      wavesurfer.drawBuffer(); // Fallback para versiones antiguas
    }

    console.log('🎨 Colores actualizados:', {
      tema: isLight ? 'LIGHT' : 'DARK',
      waveColor,
      progressColor,
    });
  }

  function loadSong(index: number) {
    const song = canciones[index];
    const wasPlaying = wavesurfer?.isPlaying() || false;

    wavesurfer?.stop();
    currentIndex = index;

    wavesurfer?.once('ready', () => {
      if (wasPlaying) {
        wavesurfer?.play();
      }
    });

    wavesurfer?.load(song.audio);
    updateWaveColors();

    return song;
  }

  // ===== INICIALIZACIÓN =====
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Crear WaveSurfer
    wavesurfer = WaveSurfer.create({
      container: '#waveform',
      height: 128,
      barWidth: 2,
      normalize: true,
      interact: true,
    });

    // 2. Cargar primera canción
    loadSong(0);

    // 3. Configurar botones (con tipos)
    const playBtn = document.getElementById('play') as HTMLButtonElement | null;
    const prevBtn = document.getElementById('prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next') as HTMLButtonElement | null;
    const cover = document.getElementById('cover') as HTMLImageElement | null;
    const iconPlay = document.getElementById('icon-play') as SVGElement | null;
    const iconPause = document.getElementById('icon-pause') as SVGElement | null;

    if (!playBtn || !prevBtn || !nextBtn || !cover || !iconPlay || !iconPause) {
      console.error('❌ Elementos no encontrados');
      return;
    }

    playBtn.addEventListener('click', () => {
      wavesurfer?.playPause();
    });

    prevBtn.addEventListener('click', () => {
      const newIndex = (currentIndex - 1 + canciones.length) % canciones.length;
      const song = loadSong(newIndex);
      if (cover) {
        cover.src = song.image;
        cover.alt = song.title;
      }
    });

    nextBtn.addEventListener('click', () => {
      const newIndex = (currentIndex + 1) % canciones.length;
      const song = loadSong(newIndex);
      if (cover) {
        cover.src = song.image;
        cover.alt = song.title;
      }
    });

    wavesurfer?.on('play', () => {
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
    });

    wavesurfer?.on('pause', () => {
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
    });

    // 4. Observer para cambios de tema
    const themeObserver = new MutationObserver(updateWaveColors);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    console.log('✅ Music Player inicializado');
    console.log('✅ Observer de tema activado');
  });
</script>
