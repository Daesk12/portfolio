---
import { projects } from '../data/projects';
import type { Project } from '../data/projects';

const totalProjects = projects.length;
---

<section id="hsec1" class="w-full h-auto p-20 flex flex-col gap-20">
  <div class="flex flex-col gap-5 items-center">
    <h1 class="text-herotitle font-900 tracking-wider font-outfit text-primary text-center">
      TRABAJOS
    </h1>

    <p class="text-caption font-700 tracking-wider font-manrope text-primary text-center">
      UN POCO DE TODO LO QUE AMO COMO DISEÑADOR.
    </p>
  </div>

  <div class="flex flex-col gap-10">
    <div class="flex items-center justify-between">
      <h2
        class="uppercase text-primary font-manrope font-700 text-caption tracking-wider underline underline-offset-8">
        PROYECTOS [{totalProjects}]
      </h2>
      <div class="flex gap-5 justify-center items-center w-2/5">
        <button
          data-view="grid"
          class="boton-activo p-2 font-outfit font-500 text-button w-2/5 rounded-lg border-2 border-secondary text-primary">
          Grid
        </button>
        <button
          data-view="list"
          class="boton-activo p-2 font-outfit font-500 text-button w-2/5 rounded-lg border-2 border-secondary text-primary">
          Lista
        </button>
      </div>
    </div>

    <div id="projects" class="projects grid-view transition-all duration-300">
      {
        projects.map((project: Project) => (
          <a
            href={`/trabajos/${project.slug}`}
            class={project.featured ? 'project-featured' : undefined}>
            <article class="project-card group">
              <div class="project-overlay project-info gap-2">
                <h3>{project.title}</h3>
                <div class="flex-cont">
                  <span>({project.year})</span>
                  <p>{project.category.es}</p>
                </div>
              </div>
              <div class="project-image">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full rounded-lg h-full object-cover"
                />
              </div>
            </article>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  type Vista = 'grid' | 'list';

  const container = document.getElementById('projects');
  const buttons = document.querySelectorAll<HTMLElement>('.boton-activo');

  if (!container) {
    throw new Error('Container #projects no encontrado');
  }

  let vistaActual: Vista = 'grid';

  const actualizarVista = (vista: Vista) => {
    vistaActual = vista;

    container.classList.toggle('grid-view', vista === 'grid');
    container.classList.toggle('list-view', vista === 'list');

    buttons.forEach((button) => {
      const activo = button.dataset.view === vista;

      button.classList.toggle('bg-secondary', activo);
      button.classList.toggle('border-0', activo);
      button.classList.toggle('text-muted', activo);
      button.classList.toggle('text-primary', !activo);
    });
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      actualizarVista(button.dataset.view as Vista);
    });
  });

  actualizarVista(vistaActual);
</script>
